# ============================================
# Wavemov CRM — Variáveis de ambiente
# Copie para .env.local e preencha os valores.
# NUNCA commite o arquivo .env.local.
# ============================================

# --- Supabase (obrigatório) ---
# Painel Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Service role — usada APENAS no servidor (webhooks, formulários públicos, admin).
# NUNCA exponha no frontend.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# --- App ---
# URL pública do app (usada para gerar links de formulários e webhook)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- UAZAPI / WhatsApp (opcional — configure quando for conectar) ---
# A UAZAPI identifica a instância só pelo token — não existe "Instance ID"
# para configurar (o id, quando a API retorna um, é só informativo).
UAZAPI_BASE_URL=https://sua-instancia.uazapi.com
UAZAPI_TOKEN=seu-token-uazapi

# --- Webhook da UAZAPI ---
# NÃO existe mais `UAZAPI_WEBHOOK_SECRET`. O segredo do webhook agora é POR
# INSTÂNCIA, guardado em `whatsapp_instances.webhook_secret` (migration 0010),
# e a rota /api/webhooks/uazapi só aceita esse valor. A URL completa aparece
# pronta em /atendimento/configuracoes para quem é `org_admin` da empresa —
# copie de lá e cole no painel da UAZAPI. Se a variável ainda existir no seu
# ambiente, pode apagar: nenhum código a lê.
