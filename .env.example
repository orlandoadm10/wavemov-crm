# ============================================
# Wavemov CRM — Variáveis de ambiente
# Copie para .env.local e preencha os valores.
# NUNCA commite o arquivo .env.local.
# ============================================

# --- Supabase (obrigatório) ---
# Painel Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Service role — usada APENAS no servidor (webhooks, formulários públicos, admin).
# NUNCA exponha no frontend.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# --- App ---
# URL pública do app (usada para gerar links de formulários e webhook)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- UAZAPI / WhatsApp (opcional — configure quando for conectar) ---
# A UAZAPI identifica a instância só pelo token — não existe "Instance ID"
# para configurar (o id, quando a API retorna um, é só informativo).
UAZAPI_BASE_URL=https://sua-instancia.uazapi.com
UAZAPI_TOKEN=seu-token-uazapi

# --- Webhook da UAZAPI ---
# NÃO existe mais `UAZAPI_WEBHOOK_SECRET`. O segredo do webhook agora é POR
# INSTÂNCIA, guardado em `whatsapp_instances.webhook_secret` (migration 0010),
# e a rota /api/webhooks/uazapi só aceita esse valor. A URL completa aparece
# pronta em /atendimento/configuracoes para quem é `org_admin` da empresa —
# copie de lá e cole no painel da UAZAPI. Se a variável ainda existir no seu
# ambiente, pode apagar: nenhum código a lê.

# --- IA: agentes de atendimento (migrations 0026–0027) ---
# API compatível com OpenAI Chat Completions. Para usar Claude, Gemini etc.
# pela OpenRouter, aponte AI_BASE_URL para https://openrouter.ai/api/v1 e use
# ids como anthropic/claude-sonnet-5 no campo "Modelo" do agente.
# Somente servidor — NUNCA use prefixo NEXT_PUBLIC_.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_DEFAULT_MODEL=gpt-4o-mini

# --- IA: base de conhecimento (embeddings, pgvector 1536 dimensões) ---
# Opcionais: sem elas, usa AI_API_KEY/AI_BASE_URL. Necessárias quando o
# provedor de chat não oferece embeddings (ex.: OpenRouter).
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_MODEL=text-embedding-3-small

# --- WhatsApp: API oficial da Meta (Cloud API) ---
# App Secret do app da Meta: valida a assinatura X-Hub-Signature-256 do
# webhook /api/webhooks/meta. Sem ele, a rota recusa tudo.
# O token de acesso e o Phone Number ID ficam por empresa, na tela
# Atendimento → Configurações (não aqui).
META_APP_SECRET=
META_GRAPH_VERSION=v21.0

# --- Automações e follow-up ---
# Protege /api/cron/automations (Authorization: Bearer <valor>). A Vercel
# envia sozinha quando CRON_SECRET existe; no n8n, use o mesmo cabeçalho.
CRON_SECRET=
